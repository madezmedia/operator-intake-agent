# Copy to .env and fill in. Never commit real values.

# --- Model (open model served on AMD via vLLM, OpenAI-compatible) ---
VLLM_ENDPOINT=http://your-mi300x-droplet:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Must match vLLM's --api-key (protect the public endpoint)
VLLM_API_KEY=
# true = rule-based fake model, no GPU needed (smoke tests only; set false for the demo)
VLLM_STUB=true

# --- Evolus workspace ---
# Leave the key empty to run offline: Evolus calls are skipped and logged, the flow still works.
EVOLUS_API_KEY=
# Space ID, sent as the X-Application-Id header
EVOLUS_APPLICATION_ID=
# Agent wired to the knowledge library (FAQ / pricing answers)
EVOLUS_AGENT_ID=
# Workflow that receives booked leads (intake -> qualify -> book -> follow-up)
EVOLUS_INTAKE_WORKFLOW_ID=
# Knowledge library ID (scripts/seed_library.py uploads docs/knowledge/*.md into it)
EVOLUS_LIBRARY_ID=
# AI Tool that drafts follow-up messages (uses credits); leave empty to skip
EVOLUS_FOLLOWUP_TOOL=email

# --- Shared memory ---
# Local dev: redis://redis:6379 (docker compose)
# Production: ACMI bridge endpoint
MEMORY_BACKEND=redis
REDIS_URL=redis://redis:6379/0

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
BUSINESS_NAME=Your Business Name
BUSINESS_TIMEZONE=America/New_York
