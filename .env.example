# Copy to .env only when you have real values. Never commit .env.
# Stub mode does not need this file: `docker compose up --build` already defaults to it.

# --- Model (open model served on AMD via vLLM + ROCm, OpenAI-compatible) ---
VLLM_ENDPOINT=http://your-mi300x-droplet:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Must match vLLM --api-key. Leave blank until the owner supplies it.
VLLM_API_KEY=
# Stub mode (rule-based model, no GPU, no network). Default true.
# Set false only for the live AMD endpoint.
# USE_STUB is an alias when VLLM_STUB is unset. VLLM_STUB wins if both are set.
VLLM_STUB=true
VLLM_TIMEOUT=60

# --- Evolus workspace ---
# Leave blank to stay offline. Calls are skipped and the intake flow still finishes.
EVOLUS_API_KEY=
# Space id, sent as the X-Application-Id header.
EVOLUS_APPLICATION_ID=
# Legacy name, used only when EVOLUS_APPLICATION_ID is empty.
EVOLUS_WORKSPACE_ID=
EVOLUS_AGENT_ID=
EVOLUS_INTAKE_WORKFLOW_ID=
EVOLUS_LIBRARY_ID=
# AI Tool name once Evolus is configured. Empty skips the draft. Built-in tool name: email
EVOLUS_FOLLOWUP_TOOL=
EVOLUS_API_BASE=https://api.evolus.ai/api/v1
EVOLUS_OPENAI_BASE=https://api.evolus.ai/v1
EVOLUS_TIMEOUT=60
EVOLUS_POLL_SECONDS=2
EVOLUS_POLL_TIMEOUT=90

# --- Shared memory ---
# Local dev: redis://redis:6379 (the compose service name is redis)
# Production: ACMI bridge endpoint, with MEMORY_BACKEND=acmi
MEMORY_BACKEND=redis
REDIS_URL=redis://redis:6379/0

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
BUSINESS_NAME=Your Business Name
BUSINESS_TIMEZONE=America/New_York
QUALIFY_THRESHOLD=60
MAX_TOOL_ROUNDS=5
